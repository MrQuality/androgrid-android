<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for outbound control plane communication -->
    <!-- Traces to: [INV-001], [INV-002], [REQ-OP-001], [REQ-OP-003] -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 14 Typed Foreground Service permissions -->
    <!-- Traces to: [REQ-VER-001] -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ Notification Runtime Permission for Foreground Service visibility -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera permissions for QR code enrollment scanner -->
    <!-- Traces to: [REQ-OP-001], [NFR-SEC-001] -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name="com.androgrid.worker.AndroGridApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="AndroGrid Worker"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main Worker Dashboard Activity -->
        <!-- Traces to: Section 6.1, [REQ-VER-001] -->
        <activity
            android:name="com.androgrid.worker.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cluster Settings and mTLS Enrollment Activity -->
        <!-- Traces to: [INV-002], [NFR-SEC-001], [REQ-OP-001] -->
        <activity
            android:name="com.androgrid.worker.ui.SettingsActivity"
            android:exported="false"
            android:label="Cluster Settings" />

        <!-- Camera QR Code Scanner Activity -->
        <!-- Traces to: [REQ-OP-001], [NFR-SEC-001] -->
        <activity
            android:name="com.androgrid.worker.ui.QrScannerActivity"
            android:exported="false"
            android:label="Scan Enrollment QR" />

        <!-- Declares Typed Foreground Service strictly outbound-only -->
        <!-- Traces to: [INV-001], [REQ-VER-001] -->
        <service
            android:name="com.androgrid.worker.service.WorkerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Headless Test Automation Intent Receiver for E2E Cluster Smoke Harness -->
        <!-- Responds exclusively via Binder IPC; opens zero listening TCP sockets -->
        <!-- Traces to: [INV-001], [INV-002], [NFR-SEC-001], [REQ-OP-001] -->
        <receiver
            android:name="com.androgrid.worker.automation.TestAutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.androgrid.worker.action.CONFIGURE_ENDPOINT" />
                <action android:name="com.androgrid.worker.action.START_PARTICIPATION" />
                <action android:name="com.androgrid.worker.action.STOP_PARTICIPATION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
